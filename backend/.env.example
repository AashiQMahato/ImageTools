PORT=5000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------- Uploads
MAX_IMAGE_SIZE_MB=10
# Largest decoded image (pixels) — protects against decompression bombs.
MAX_IMAGE_PIXELS=40000000
# Image-processing requests per client per 15 minutes, and how many may wait for a free slot.
PROCESSING_RATE_LIMIT=60
PROCESSING_MAX_QUEUE=8

# ---------------------------------------------------------------- Background removal (rembg)
# Model used by the internal Python service. Run scripts/setup-ml.sh after changing it (downloads the model).
#   bria-rmbg              best quality; ~1 GB; needs ~16 GB RAM to be fast. Licence: CC BY-NC 4.0 (non-commercial).
#   birefnet-general       excellent quality; MIT.            birefnet-general-lite  faster BiRefNet; MIT.
#   isnet-general-use      good quality, ~1 s on CPU; Apache-2.0.
#   u2netp                 tiny and very fast, lower quality; for low-resource machines.
REMBG_MODEL=bria-rmbg
# The API starts the Python service itself (on a random localhost port with a per-launch token).
# To run it separately instead, set REMBG_AUTOSTART=false and point REMBG_SERVICE_URL/REMBG_SERVICE_TOKEN at it.
REMBG_AUTOSTART=true
REMBG_SERVICE_URL=
REMBG_SERVICE_TOKEN=
REMBG_TIMEOUT_MS=120000
BACKGROUND_REMOVAL_CONCURRENCY=2
REMBG_DECONTAMINATE=true
REMBG_ALPHA_MATTING=false

# ---------------------------------------------------------------- Upscaling (Upscayl / upscayl-ncnn)
# Leave paths empty to use backend/vendor/upscayl (installed by scripts/setup-ml.sh).
UPSCAYL_ENABLED=true
UPSCAYL_BINARY_PATH=
UPSCAYL_MODELS_PATH=
# One of the installed models: upscayl-standard-4x (default), upscayl-lite-4x (much faster), digital-art-4x.
UPSCAYL_MODEL=upscayl-standard-4x
UPSCALE_TIMEOUT_MS=300000
UPSCALE_CONCURRENCY=1
# Largest upscaled result, in pixels (4× accepts smaller inputs than 2×).
UPSCALE_MAX_OUTPUT_PIXELS=40000000
# Reserved for an optional hosted fallback. Server-side only — never put this in the frontend.
UPSCAYL_API_KEY=

# ---------------------------------------------------------------- Legacy provider keys (unused)
REMOVE_BG_API_KEY=
UPSCALE_API_KEY=
